{
  "button": {
    "height": {
      "$type": "dimension",
      "$value": "{size.tap-lg}"
    },
    "height-compact": {
      "$type": "dimension",
      "$value": "40px"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "16.6px"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "border-width": {
      "$type": "dimension",
      "$value": "1px"
    },
    "primary": {
      "border": {
        "$type": "color",
        "$value": "{color.accent.default}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.accent-strong}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.accent.hover-tint}"
      },
      "bg-active": {
        "$type": "color",
        "$value": "{color.accent.active-tint}"
      }
    },
    "secondary": {
      "border": {
        "$type": "color",
        "$value": "{color.border.default}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.default}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "rgba(32,31,29,0.07)"
      }
    },
    "ghost": {
      "text": {
        "$type": "color",
        "$value": "{color.accent.default}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "rgba(182,130,53,0.10)"
      }
    }
  },
  "input": {
    "height": {
      "$type": "dimension",
      "$value": "{size.input-lg}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.17}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.input}"
    },
    "border-error": {
      "$type": "color",
      "$value": "{color.status.error-border}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{color.accent.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "unit-color": {
      "$type": "color",
      "$value": "{color.text.muted}"
    }
  },
  "option-tile": {
    "min-height": {
      "$type": "dimension",
      "$value": "60px"
    },
    "padding": {
      "$type": "dimension",
      "$value": "14px 16px"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-selected": {
      "$type": "color",
      "$value": "{color.accent.default}"
    },
    "bg-selected": {
      "$type": "color",
      "$value": "rgba(182,130,53,0.08)"
    },
    "radio-size": {
      "$type": "dimension",
      "$value": "18px"
    },
    "radio-unknown-style": {
      "$type": "strokeStyle",
      "$value": "dashed"
    }
  },
  "progress": {
    "segment-height": {
      "$type": "dimension",
      "$value": "8px"
    },
    "done": {
      "$type": "color",
      "$value": "{color.accent.default}"
    },
    "current": {
      "$type": "color",
      "$value": "{color.accent.700}"
    },
    "todo": {
      "$type": "color",
      "$value": "{color.neutral.500}"
    }
  },
  "norm-stamp": {
    "border": {
      "$type": "color",
      "$value": "{color.border.strong}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.12}"
    },
    "padding-type": {
      "$type": "dimension",
      "$value": "4px 6px"
    },
    "padding-code": {
      "$type": "dimension",
      "$value": "4px 7px"
    }
  },
  "card": {
    "padding": {
      "$type": "dimension",
      "$value": "{space.16}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{color.accent.default}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    }
  },
  "plate": {
    "mat": {
      "$type": "dimension",
      "$value": "6px"
    },
    "mat-color": {
      "$type": "color",
      "$value": "{color.bg.surface}"
    },
    "outline": {
      "$type": "color",
      "$value": "{color.border.default}"
    }
  },
  "tag": {
    "font-size": {
      "$type": "dimension",
      "$value": "{font.size.11}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "3px 10px"
    },
    "accent-bg": {
      "$type": "color",
      "$value": "{color.accent.100}"
    },
    "accent-text": {
      "$type": "color",
      "$value": "{color.accent.800}"
    },
    "neutral-bg": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "neutral-text": {
      "$type": "color",
      "$value": "{color.neutral.800}"
    }
  },
  "table": {
    "cell-padding": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "head-size": {
      "$type": "dimension",
      "$value": "{font.size.11}"
    },
    "rule": {
      "$type": "color",
      "$value": "{color.border.default}"
    }
  },
  "header": {
    "height": {
      "$type": "dimension",
      "$value": "72px"
    },
    "height-mobile": {
      "$type": "dimension",
      "$value": "60px"
    }
  },
  "sticky-bar": {
    "height": {
      "$type": "dimension",
      "$value": "72px"
    },
    "bg": {
      "$type": "color",
      "$value": "{color.bg.default}"
    }
  },
  "toast": {
    "border": {
      "$type": "color",
      "$value": "{color.border.strong}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    }
  }
}