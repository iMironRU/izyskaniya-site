{
  "button": {
    "primary": {
      "$type": "color",
      "bg":          { "$value": "{color.bg.inverse}" },
      "bg-hover":    { "$value": "{color.neutral.700}" },
      "bg-active":   { "$value": "{color.neutral.900}" },
      "fg":          { "$value": "{color.text.inverse}" }
    },
    "secondary": {
      "$type": "color",
      "bg":          { "$value": "{color.bg.surface}" },
      "bg-hover":    { "$value": "{color.bg.subtle}" },
      "border":      { "$value": "{color.border.strong}" },
      "fg":          { "$value": "{color.text.primary}" }
    },
    "text": {
      "$type": "color",
      "fg":          { "$value": "{color.accent.default}" },
      "fg-hover":    { "$value": "{color.accent.hover}" }
    },
    "disabled": {
      "$type": "color",
      "bg":          { "$value": "{color.neutral.200}" },
      "fg":          { "$value": "{color.text.disabled}" }
    },
    "height": {
      "$type": "dimension",
      "md": { "$value": "{space.12}", "$description": "48px" },
      "lg": { "$value": "{space.13}", "$description": "52px" }
    },
    "padding-x": { "$type": "dimension", "$value": "{space.5}" }
  }
}
