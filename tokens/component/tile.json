{
  "tile": {
    "$description": "Плитка варианта ответа в калькуляторе",
    "border":          { "$type": "color", "$value": "{color.border.control}" },
    "border-hover":    { "$type": "color", "$value": "{color.border.strong}" },
    "border-selected": { "$type": "color", "$value": "{color.accent.default}" },
    "bg":              { "$type": "color", "$value": "{color.bg.surface}" },
    "bg-hover":        { "$type": "color", "$value": "{color.neutral.100}" },
    "bg-selected":     { "$type": "color", "$value": "{color.accent.subtle}" },
    "indicator":          { "$type": "color", "$value": "{color.neutral.600}" },
    "indicator-selected": { "$type": "color", "$value": "{color.accent.default}" },
    "min-height":      { "$type": "dimension", "$value": "{space.16}" }
  }
}
