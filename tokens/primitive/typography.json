{
  "typeface": {
    "$type": "fontFamily",
    "serif": { "$value": ["PT Serif", "Georgia", "serif"] },
    "sans":  { "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] },
    "mono":  { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "xs":  { "$value": "0.75rem",   "$description": "12px" },
      "sm":  { "$value": "0.8125rem", "$description": "13px" },
      "md":  { "$value": "0.9375rem", "$description": "15px" },
      "lg":  { "$value": "1rem",      "$description": "16px" },
      "xl":  { "$value": "1.125rem",  "$description": "18px" },
      "2xl": { "$value": "1.375rem",  "$description": "22px" },
      "3xl": { "$value": "1.625rem",  "$description": "26px" },
      "4xl": { "$value": "1.8125rem", "$description": "29px" },
      "5xl": { "$value": "2.25rem",   "$description": "36px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },
    "leading": {
      "$type": "number",
      "tight":  { "$value": 1.15 },
      "snug":   { "$value": 1.3 },
      "normal": { "$value": 1.45 }
    },
    "tracking": {
      "$type": "dimension",
      "normal": { "$value": "0em" },
      "wide":   { "$value": "0.06em" }
    }
  }
}
