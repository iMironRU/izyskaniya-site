{
  "space": {
    "$type": "dimension",
    "$description": "Шкала отступов. Ключ × 4px, как в Tailwind.",
    "0":  { "$value": "0rem" },
    "px": { "$value": "1px" },
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.25rem" },
    "6":  { "$value": "1.5rem" },
    "8":  { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "11": { "$value": "2.75rem", "$description": "44px — минимальная зона нажатия" },
    "12": { "$value": "3rem" },
    "13": { "$value": "3.25rem" },
    "16": { "$value": "4rem" },
    "24": { "$value": "6rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "sm":   { "$value": "0.125rem" },
    "md":   { "$value": "0.25rem" },
    "full": { "$value": "9999px" }
  },
  "border-width": {
    "$type": "dimension",
    "thin":  { "$value": "1px" },
    "thick": { "$value": "1.5px" },
    "focus": { "$value": "3px" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Mobile-first: стили без префикса — телефон.",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" }
  }
}
