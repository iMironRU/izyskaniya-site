{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["build/**", "out/**", ".next/**", "storybook-static/**"],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "oklch", "lab", "lch"],
    "unit-disallowed-list": ["px"],
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["theme", "source", "utility", "variant", "custom-variant", "plugin", "config", "reference", "apply", "layer"] }],
    "import-notation": "string",
    "custom-property-pattern": null
  }
}
